APP_NAME=Enterprise Knowledge RAG
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Docker Hub 访问不稳定时默认使用国内加速镜像；若你的网络可直连 Docker Hub，可改回官方镜像：
# BACKEND_PYTHON_IMAGE=python:3.11-slim
# FRONTEND_NODE_IMAGE=node:20-alpine
# FRONTEND_NGINX_IMAGE=nginx:1.27-alpine
BACKEND_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
FRONTEND_NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
FRONTEND_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# mock 为默认演示模式，不依赖外部模型。
LLM_MODE=mock
EMBEDDING_MODE=mock

# 使用 OpenAI-compatible API 时改为 openai，并填入以下配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

CHUNK_SIZE=900
CHUNK_OVERLAP=140
MIN_CHUNK_SIZE=120
RETRIEVAL_TOP_K=8
ANSWER_MIN_SCORE=0.22
ANSWER_MIN_RERANK_SCORE=0.08
ANSWER_MIN_EVIDENCE_COUNT=1
PROMPT_VERSION=v1
UPLOAD_DIR=data/uploads

# 登录演示账号：admin/admin123、manager/manager123、hr/hr123、employee/employee123
AUTH_SECRET_KEY=dev-rag-secret
AUTH_TOKEN_TTL_MINUTES=1440
